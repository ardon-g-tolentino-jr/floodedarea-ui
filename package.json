{
  "name": "baha-ui",
  "private": true,
  "version": "1.59.0",
  "type": "module",
  "description": "FloodedArea — a flood-watch web app for the Philippines (reports, shelters, alerts, SOS).",
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "dev:mock": "concurrently -n vite,mock -c blue,green \"VITE_API_URL=http://localhost:3001 vite\" \"npm:mock\"",
    "mock": "node mock-api/server.cjs",
    "demo": "concurrently -k -n vite,mock \"VITE_API_URL=http://localhost:3001 vite --port 5188 --strictPort\" \"node mock-api/server.cjs\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "json-server": "^0.17.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0"
  }
}
