# Production overrides applied during `npm run build`.
# The app is served behind a reverse proxy (see Dockerfile / nginx) that exposes the
# backend under same-origin /api, so VITE_API_URL stays relative — no CORS, no hardcoded
# host. VITE_GOOGLE_CLIENT_ID is intentionally not set here so it's inherited from .env
# (local builds) or the Docker build arg — setting it empty here would blank SSO.
VITE_API_URL=/api
