# Production overrides applied during `npm run build` (baked into dist/).
# PROD API — the deployed floodedarea-api. The browser calls this host directly, so the
# API's BAHA_CORS_ALLOWED_ORIGINS must include the UI's deployed origin.
# (To serve same-origin behind the nginx reverse proxy instead, set VITE_API_URL=/api.)
# VITE_GOOGLE_CLIENT_ID is intentionally unset here — inherited from .env (local builds)
# or the Docker build arg — so it isn't blanked.
VITE_API_URL=https://floodedarea-api-okno9l-05c7b8-187-77-132-247.sslip.io
