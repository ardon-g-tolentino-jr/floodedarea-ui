# Backend API base. Dev defaults to the Vite proxy ('/api' → http://localhost:8083).
# Set this to override (e.g. the json-server mock or a deployed API).
VITE_API_URL=

# Google OAuth 2.0 Web client ID (same value as the API's GOOGLE_CLIENT_ID).
# Leave blank to hide Google SSO; Basic login still works.
VITE_GOOGLE_CLIENT_ID=
